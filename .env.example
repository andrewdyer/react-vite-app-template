# Copy this file to .env for local development. In a container, set the same variables on the
# container instead; they are written to config.js at startup and override built-in values.

# The application's display name, shown as the home screen's heading.
VITE_APP_NAME=React + Vite

# The base URL of the API the application requests data from.
VITE_API_URL=http://localhost:3000/api

# Set to "enabled" to answer API requests from the mock handlers in src/mocks during `pnpm dev`.
# Development only: production builds never include the mocks.
VITE_API_MOCKING=enabled
