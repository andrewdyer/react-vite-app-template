{
  // Extend the shared Node config (modern JS, noEmit)
  "extends": "@repo/typescript-config/tsconfig.node.json",
  "compilerOptions": {
    // Where TypeScript stores incremental build info for this config.
    // Separate from the app cache to avoid conflicts.
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  // Only type-check the Vite config (Node context, not browser).
  "include": ["vite.config.ts"]
}
