{
  "private": true,
  "name": "react-vite-app-template",
  "description": "A template for building frontend applications using Vite and React with TypeScript",
  "author": "Andrew Dyer <andrew@dyermail.com>",
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "build:storybook": "storybook build",
    "lint": "eslint .",
    "prepare": "husky",
    "format": "prettier --write '**/*.{js,jsx,ts,tsx,json,css,md}'",
    "preview": "vite preview",
    "start": "vite",
    "start:storybook": "storybook dev -p 6006",
    "test": "vitest --run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "react": "~19.2.9",
    "react-dom": "~19.2.9",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/addon-onboarding": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "~6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.18",
    "@types/react-dom": "~19.2.7",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.6.5",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "prettier": "^3.9.6",
    "storybook": "^10.6.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12"
  },
  "lint-staged": {
    "*": "prettier --ignore-unknown --write"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
